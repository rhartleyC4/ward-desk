# Frontend (exposed to the browser; safe to ship)
# For local development, `npm run db:env` writes these into .env from the running local Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# The ward's name, shown in the header and as the installed app's name
VITE_WARD_NAME=Ward Desk
VITE_WARD_TIME_ZONE=America/Denver
# Set to true once Google OAuth is configured in Supabase Auth
VITE_ENABLE_GOOGLE=false
# 'staging' shows the training banner and practice sign-in; 'production' for the real site.
# Leave empty locally. CI sets it when deploying.
VITE_APP_ENV=

# Server only (Edge Functions / Supabase secrets). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
