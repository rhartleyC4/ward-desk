---
import Marketing from '../layouts/Marketing.astro'
import Hero from '../components/landing/Hero.astro'
import Feature from '../components/landing/Feature.astro'
import RoleTour from '../components/landing/RoleTour.astro'
import Privacy from '../components/landing/Privacy.astro'
import OpenSource from '../components/landing/OpenSource.astro'
import ClosingCta from '../components/landing/ClosingCta.astro'
---
<Marketing
  description="Ward Desk keeps callings, meeting agendas, sacrament meeting, appointments and requests in one private place for bishoprics, secretaries and ward leaders. Free and open source."
>
  <!-- Hide reveal targets before they paint, but only when motion is welcome and JS is running. -->
  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('reveal-on')
    }
  </script>

  <Hero />

  <section id="features" class="features" aria-labelledby="features-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <p class="eyebrow">What it does</p>
        <h2 id="features-title">The week's ward business, without the scattered texts</h2>
        <p>Everything a bishopric and ward council keep track of, in one place everyone can reach from their phone.</p>
      </header>

      <Feature
        kicker="Callings"
        title="Work through callings together, in confidence"
        shot="agenda-bishopric-callings"
        alt="Callings on the bishopric agenda: a new request from a leader, names to consider and callings waiting to be set apart"
        docs="/docs/callings/"
        docsLabel="How callings work"
      >
        <p>
          What's needed, the names being considered and where each calling stands sit right on the
          bishopric agenda. <strong>Leaders can ask for a calling to be filled and suggest names</strong>,
          then follow along without ever seeing the discussion.
        </p>
      </Feature>

      <Feature
        kicker="Meetings"
        title="Agendas that are ready when you sit down"
        shot="agenda-ward-council"
        alt="The ward council agenda with a section for each organization"
        docs="/docs/meetings/"
        docsLabel="About meeting agendas"
        flip
      >
        <p>
          Bishopric meeting and ward council each have their own agenda, with a place for every
          organization. Hand an item to someone and see where it stands, and ask people to give the
          prayers or a spiritual thought.
        </p>
      </Feature>

      <Feature
        kicker="Sacrament meeting"
        title="Plan Sundays well before they arrive"
        shot="sacrament"
        alt="Sacrament meeting planning: the coming Sundays with who is conducting, speakers and hymns"
        docs="/docs/sacrament/"
        docsLabel="Planning sacrament meeting"
      >
        <p>
          See the coming Sundays at a glance: who's conducting, speakers, topics and hymns. <strong>Fast Sundays and conferences are marked for you</strong>, so a special Sunday never
          catches anyone off guard.
        </p>
      </Feature>

      <Feature
        kicker="Appointments"
        title="Secretaries book around each leader's hours"
        shot="appointments-booking"
        alt="An executive secretary booking an appointment, choosing from a leader's open times"
        docs="/docs/appointments/"
        docsLabel="How booking works"
        flip
      >
        <p>
          The bishop and counselors set the hours they can meet and the days they'll be away.
          Secretaries see who still needs a time, send a few open times from their own phone, and
          book the one that works.
        </p>
      </Feature>

      <Feature
        kicker="Requests"
        title="Ask once, and know it's handled"
        shot="requests-received"
        alt="A request received, with buttons for Got it and It's done"
        docs="/docs/requests/"
        docsLabel="About requests"
      >
        <p>
          When the bishopric asks someone to do something, they tap <strong>Got it</strong> once they've
          seen it and <strong>It's done</strong> when it's finished. No more wondering whether a message
          landed.
        </p>
      </Feature>

      <Feature
        kicker="Notifications"
        title="Gentle reminders that never name anyone"
        shot="settings-notifications"
        alt="Notification settings: tomorrow's summary, how did today go, and other reminders, each with its own switch"
        docs="/docs/settings/"
        docsLabel="Choosing notifications"
        flip
      >
        <p>
          A summary of tomorrow each evening, a nudge after the day's interviews, and a heads-up for
          secretaries with reminders to send. Lock screens only ever show when and how many, never who
          or why.
        </p>
      </Feature>
    </div>
  </section>

  <RoleTour />
  <Privacy />
  <OpenSource />
  <ClosingCta />
</Marketing>

<script>
  // Fade sections in as they scroll into view. Without this script (or with reduced motion) they
  // are simply visible, because `reveal-on` is never set.
  const root = document.documentElement
  if (root.classList.contains('reveal-on')) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in')
            io.unobserve(e.target)
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    )
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))
  }
</script>

<style>
  :global(main) { padding-top: 0; }
  .features { scroll-margin-top: 4rem; padding-block: 2rem; }
  @media (min-width: 60rem) { .features { padding-top: 6rem; } }
</style>
