---
import Marketing from '../layouts/Marketing.astro'
import Screenshot from '../components/Screenshot.astro'
import { DEMO_URL, SIGN_IN_URL } from '../site.config'
---
<Marketing>
  <div class="wrap hero">
    <div>
      <h1>Ward administration in one place</h1>
      <p>Placeholder landing page. TODO(round 2): hero, feature sections, screenshots, calls to action.</p>
      <p class="actions">
        <a class="btn" href={DEMO_URL}>Try the demo</a>
        <a class="btn secondary" href={SIGN_IN_URL}>Sign in</a>
      </p>
    </div>
    <Screenshot name="placeholder" device="phone" alt="Placeholder app screen" loading="eager" />
  </div>
  <section id="features" class="wrap">
    <h2>Features</h2>
    <p>TODO(round 2).</p>
  </section>
</Marketing>

<style>
  .hero { display: grid; gap: 2rem; align-items: center; justify-items: center; padding-block: 1rem 3rem; text-align: center; }
  .hero h1 { font-size: 1.75rem; line-height: 1.25; margin: 0 0 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  #features { scroll-margin-top: 5rem; }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 1fr auto; text-align: left; }
    .hero h1 { font-size: 2.5rem; }
    .actions { justify-content: flex-start; }
  }
</style>
