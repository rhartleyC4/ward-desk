---
import '@fontsource-variable/lexend'
import '../styles/tokens.css'
import '../styles/marketing.css'
import ThemeScript from '../components/ThemeScript.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import logo from '../assets/logo.svg'
import { SITE_NAME, SIGN_IN_URL, REPO_URL } from '../site.config'

interface Props {
  title?: string
  description?: string
}
const { title, description = 'Ward administration in one place: agendas, callings, sacrament meeting, appointments and requests.' } = Astro.props
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: ward administration in one place`
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <ThemeScript />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/"><img src={logo.src} width="32" height="32" alt="" /><span>{SITE_NAME}</span></a>
        <nav aria-label="Main">
          <a class="optional" href="/#features">Features</a>
          <a href="/docs/">Docs</a>
          <a class="optional" href={REPO_URL}>GitHub</a>
          <a class="signin" href={SIGN_IN_URL}>Sign in</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="/docs/">Docs</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href={REPO_URL}>GitHub</a>
        </nav>
        <p>Not affiliated with The Church of Jesus Christ of Latter-day Saints.</p>
        <p>Open source, provided as is.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; padding: 0.5rem 1rem; background: var(--wd-paper); z-index: 10; }
  .skip:focus { left: 0; }
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background-color: var(--wd-glass-bg);
    -webkit-backdrop-filter: blur(20px) saturate(180%); backdrop-filter: blur(20px) saturate(180%);
    box-shadow: var(--wd-glass-shadow);
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header { background-color: var(--wd-paper); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  .bar { display: flex; align-items: center; gap: 0.5rem; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 0.625rem; font-weight: 700; color: var(--wd-text); text-decoration: none; margin-right: auto; }
  nav { display: flex; align-items: center; gap: 0.25rem; }
  nav a { padding: 0.625rem 0.75rem; color: var(--wd-text); text-decoration: none; font-weight: 500; border-radius: var(--wd-radius); }
  nav a:hover { color: var(--wd-primary); }
  nav a.signin { color: var(--wd-on-primary); background: var(--wd-primary); font-weight: 600; }
  nav a.signin:hover { color: var(--wd-on-primary); opacity: 0.9; }
  @media (max-width: 36rem) { nav a.optional { display: none; } }
  .site-footer { border-top: 1px solid var(--wd-divider); padding-block: 2rem; color: var(--wd-text-2); font-size: 0.875rem; }
  .site-footer nav { flex-wrap: wrap; margin-left: -0.75rem; }
  .site-footer nav a { color: var(--wd-text); }
  .site-footer p { margin: 0.25rem 0; }
</style>
