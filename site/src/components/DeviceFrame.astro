---
// A phone or browser window around whatever is slotted in (usually <Screenshot>).
interface Props {
  kind?: 'phone' | 'browser'
  /** Shown in the browser frame's address bar. */
  url?: string
}
const { kind = 'phone', url = 'gp7.warddesk.app' } = Astro.props
---
<figure class:list={['frame', kind]}>
  {kind === 'browser' && (
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div>
  )}
  <div class="screen"><slot /></div>
</figure>

<style>
  .frame { margin: 0; background: var(--wd-device-body); box-shadow: 0 24px 48px rgb(0 0 0 / 0.18); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  .phone { width: min(100%, 17.5rem); padding: 0.5rem; border-radius: 2.25rem; }
  .phone .screen { border-radius: 1.75rem; overflow: hidden; background: var(--wd-bg); }
  .browser { width: 100%; border-radius: var(--wd-radius); overflow: hidden; }
  .chrome { display: flex; align-items: center; gap: 0.375rem; padding: 0.625rem 0.75rem; }
  .chrome i { width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--wd-text-2); opacity: 0.6; }
  .chrome span { flex: 1; margin-left: 0.5rem; padding: 0.125rem 0.75rem; border-radius: 999px; font-size: 0.75rem; color: var(--wd-text-2); background: var(--wd-bg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
