---
// A phone or browser window around whatever is slotted in (usually <Screenshot>).
// Set --phone-w on a parent to size the phone (default 17.5rem).
interface Props {
  kind?: 'phone' | 'browser'
  /** Shown in the browser frame's address bar. */
  url?: string
  class?: string
}
const { kind = 'phone', url = 'gp7.warddesk.app', class: className } = Astro.props
---
<figure class:list={['frame', kind, className]}>
  {kind === 'browser' && (
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div>
  )}
  <div class="screen"><slot /></div>
</figure>

<style>
  .frame { margin: 0; background: var(--wd-device-body); box-shadow: var(--wd-device-shadow); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  .phone {
    width: min(100%, var(--phone-w, 17.5rem));
    padding: calc(var(--phone-w, 17.5rem) * 0.03);
    border-radius: calc(var(--phone-w, 17.5rem) * 0.14);
    box-shadow: var(--wd-device-shadow), inset 0 0 0 1px var(--wd-device-edge);
  }
  .phone .screen { border-radius: calc(var(--phone-w, 17.5rem) * 0.11); overflow: hidden; background: var(--wd-bg); }
  .browser { width: 100%; border-radius: var(--wd-radius); overflow: hidden; box-shadow: var(--wd-device-shadow), inset 0 0 0 1px var(--wd-device-edge); }
  .browser .screen { background: var(--wd-bg); }
  .chrome { display: flex; align-items: center; gap: 0.375rem; padding: 0.625rem 0.75rem; }
  .chrome i { width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--wd-device-dot); }
  .chrome span { flex: 1; max-width: 22rem; margin-inline: auto; padding: 0.125rem 0.75rem; border-radius: 999px; font-size: 0.75rem; text-align: center; color: var(--wd-device-dot); background: var(--wd-device-edge); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
