{
  "name": "ward-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:db": "supabase test db",
    "test:all": "npm run test && npm run test:db && npm run test:integration",
    "db:start": "npm run functions:build && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --agent no > src/lib/database.types.ts",
    "db:env": "node scripts/write-local-env.mjs",
    "notify": "tsx scripts/notify/send.ts",
    "functions:build": "esbuild scripts/notify/tick.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/notify/tick.bundle.js --log-level=warning",
    "functions:deploy": "npm run functions:build && supabase functions deploy notify",
    "notify:setup": "node scripts/setup-notify.mjs",
    "alerts:setup": "node scripts/setup-alerts.mjs",
    "setup": "node scripts/setup.mjs",
    "env:check": "node scripts/env-check.mjs",
    "env:github": "node scripts/env-github.mjs",
    "env:auth": "node scripts/env-auth.mjs",
    "backup:restore": "node scripts/backup-restore.mjs",
    "admin:add": "node scripts/admin-add.mjs",
    "import-sheets": "tsx scripts/import-sheets/import.ts",
    "export-sheets": "tsx scripts/export-sheets/export.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/lexend": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "age-encryption": "^0.3.1",
    "aws4fetch": "^1.0.20",
    "esbuild": "0.28.2",
    "exceljs": "^4.4.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=24"
  }
}
