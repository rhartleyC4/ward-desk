# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
#
# The service worker decides which build an installed app runs, so browsers must check these on
# every launch. Otherwise a 4-hour cache keeps an installed app on the old build after a deploy.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/push-handler.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Built files have a content hash in their names, so a new build always has new names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
